#pragma code_page(65001)
#include <windows.h>

1 VERSIONINFO
 FILEVERSION @WORKPANE_APP_NUMERIC_VERSION@,@APP_BUILD@
 PRODUCTVERSION @WORKPANE_APP_NUMERIC_VERSION@,@APP_BUILD@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", @WORKPANE_APP_ORGANIZATION_LITERAL@
   VALUE "FileDescription", @WORKPANE_APP_NAME_LITERAL@
   VALUE "FileVersion", @WORKPANE_APP_FILE_VERSION_LITERAL@
   VALUE "OriginalFilename", "@target@.exe"
   VALUE "ProductName", @WORKPANE_APP_NAME_LITERAL@
   VALUE "ProductVersion", @WORKPANE_APP_VERSION_LITERAL@
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
